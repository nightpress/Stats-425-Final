# Copy to the repo root as .env before `docker compose ... up`. Fill in your key.
# The attacker reaches Claude natively via langchain-anthropic using this key.

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: pin the C2 server address if you changed it (defaults work for the
# bundled compose range).
# C2C_SERVER=http://localhost:8888
